# Supabase pooled connection (used by Prisma for queries)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (used by Prisma for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# Random secret used to AES-256 encrypt stored PATs — keep this safe
ENCRYPTION_PASSPHRASE="change-me-to-a-long-random-secret"

# Public URL of this deployment (used in generated embed URLs)
NEXT_PUBLIC_APP_URL="https://your-domain.com"
